{
  "name": "kokio",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11.16.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:console": "node scripts/scan-console.mjs",
    "audit": "npx audit-ci --config audit-ci.jsonc",
    "gen:auth-types": "bash scripts/gen-auth-types.sh",
    "gen:bff-types": "bash scripts/gen-bff-types.sh",
    "postinstall": "patch-package && node scripts/sync-native-version.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|jose|uuid))"
    ]
  },
